// ============================================================
// 階層型在庫管理システム - Prismaスキーマ
// ============================================================
// DATABASE_URL は .env.local から読み込み
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// Tenant: テナント（マルチテナント化 フェーズ3 S1で追加）
// ============================================================
// 1テナント = 1独立した在庫管理システム。既定テナント(slug=default)に既存データを属させる。
model Tenant {
  id         String   @id @default(cuid())
  name       String                           // 顧客名/インスタンス名（既定=GAINER）
  slug       String   @unique                 // URL識別子 /t/:slug（既定=default）
  licenseKey String?  @unique                 // 発行キー。ユーザーが入力して有効化。既定テナントはnull可
  stockMode  String   @default("perCategory") // 発行時に固定する在庫モード（S1では予備。正はSystemSettings.stockMode）
  status     String   @default("active")      // pending / active / suspended
  // 契約/課金（運営者が総括ページで管理。すべて任意）
  plan              String?   // プラン名（自由入力。例: basic / pro）
  monthlyFee        Int?      // 月額料金（円）
  billingStatus     String?   // 課金状態: trial / paid / unpaid / free
  contractStartDate DateTime? // 契約開始日
  nextBillingDate   DateTime? // 次回請求日
  billingNote       String?   // 課金メモ（連絡先・請求状況など自由記述）
  billingType       String?   // EC課金種別: monthly / yearly / onetime（EC連携発行時に記録）
  provisionOrderId  String?  @unique // EC注文ID（連携発行の冪等キー。同一注文の二重発行を防止）
  suspendReason     String?  // 停止理由の記録（EC連携: cancelled=解約 / suspended=一時停止。挙動は同じ、区別記録用）
  // プラン上限（null=無制限＝プロ相当。プラン発行/変更時にECから受け取ってセット）
  maxParts          Int?      // 登録パーツ数の上限
  maxImageMB        Int?      // 画像容量の上限（MB）
  maxUsers          Int?      // 一般ユーザー数の上限（管理者は含めない）
  ecProductId       String?   // EC の商品ID（どのプランか。記録・参照用）
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  admins         Admin[]
  users          User[]
  categories     Category[]
  genres         Genre[]
  units          Unit[]
  parts          Part[]
  partMasters    PartMaster[]
  diagramImages  DiagramImage[]
  systemSettings SystemSettings[]
  stockCountLogs StockCountLog[]

  @@index([status])
  @@map("tenants")
}

// ============================================================
// Admin: 管理者
// ============================================================
model Admin {
  id        String   @id @default(cuid())
  email     String   // テナント内で一意（@@unique([tenantId, email])）。別テナントの同一emailは許容
  password  String   // bcryptでハッシュ化
  name        String?   // 登録者名（有効化フォームでは必須。DB上は既存互換でoptional）
  companyName String?   // 会社名（企業登録時。任意）
  department  String?   // 部署（企業登録時。任意）
  role        String    @default("admin") // master / admin（masterは運営者=全テナント横断）
  tenantId    String
  lastLoginAt DateTime? // 最終ログイン日時（総括ページで休眠顧客把握に使用。未ログインはnull）
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, email])
  @@index([tenantId])
  @@map("admins")
}

// ============================================================
// User: 一般ユーザー
// ============================================================
model User {
  id        String   @id @default(cuid())
  email     String   // テナント内で一意（@@unique([tenantId, email])）。別テナントの同一emailは許容
  password  String   // bcryptでハッシュ化
  name      String?  // 表示名（オプション）
  tenantId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, email])
  @@index([tenantId])
  @@map("users")
}

// ============================================================
// Category: カテゴリー
// ============================================================
model Category {
  id              String   @id @default(cuid())
  categoryId      String?  // カテゴリーID（ユーザー定義）
  name            String   // 同名カテゴリーを許可
  subtitle        String?  // サブタイトル
  imageUrl        String?  // 画像URL
  cropPositionX   Float?   @default(0.5) // 画像のクロップ位置X (0.0 ~ 1.0)
  cropPositionY   Float?   @default(0.5) // 画像のクロップ位置Y (0.0 ~ 1.0)
  order           Int      @default(0)
  tenantId        String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  genres          Genre[]
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([order])
  @@map("categories")
}

// ============================================================
// Genre: ジャンル
// ============================================================
model Genre {
  id            String   @id @default(cuid())
  genreId       String?  // ジャンルID（ユーザー定義）
  categoryId    String
  name          String
  subtitle      String?  // サブタイトル
  imageUrl      String?
  cropPositionX Float?   @default(0.5) // 画像のクロップ位置X (0.0 ~ 1.0)
  cropPositionY Float?   @default(0.5) // 画像のクロップ位置Y (0.0 ~ 1.0)
  order         Int      @default(0)
  tenantId      String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  category      Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  units         Unit[]
  parts         Part[]
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([categoryId])
  @@index([order])
  @@map("genres")
}

// ============================================================
// Unit: ユニット（新規追加）
// ============================================================
model Unit {
  id            String         @id @default(cuid())
  genreId       String
  unitNumber    String
  unitName      String
  imageUrl      String?
  cropPositionX Float?         @default(0.5) // 画像のクロップ位置X (0.0 ~ 1.0)
  cropPositionY Float?         @default(0.5) // 画像のクロップ位置Y (0.0 ~ 1.0)
  partsCount    Int            @default(0)
  sortOrder     Int            @default(0)   // 並び順
  tenantId      String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  genre         Genre          @relation(fields: [genreId], references: [id], onDelete: Cascade)
  parts         Part[]         // このユニットに属するパーツ
  diagramImage  DiagramImage[] // ユニット専用の展開図
  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, genreId, unitNumber])
  @@index([tenantId])
  @@index([genreId])
  @@index([sortOrder])
  @@map("units")
}

// ============================================================
// Part: パーツ
// ============================================================
model Part {
  id                  String     @id @default(cuid())
  genreId             String
  unitId              String?    // ユニットID（外部キー）
  unitNumber          String     // ユニット個別番号（手入力、例: "1-2-1"）
  partNumber          String
  partName            String
  quantity            Int?       // 数量
  price               Float?     // 価格（JPY登録時の手入力価格、または換算不要時の表示価格）
  currency            String?    @default("JPY") // 元通貨（JPY/EUR/USD等）。海外通貨の場合、表示時に当日レートで円換算する
  originalPrice       Float?     // 元通貨での価格（currencyがJPY以外のとき使用）
  storageCase         String?
  notes               String?
  orderDate           DateTime?
  expectedArrivalDate DateTime?
  imageUrl            String?
  cropPositionX       Float?     @default(0.5) // 画像のクロップ位置X (0.0 ~ 1.0)
  cropPositionY       Float?     @default(0.5) // 画像のクロップ位置Y (0.0 ~ 1.0)
  sortOrder           Int        @default(0)   // 並び順
  tenantId            String
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
  genre               Genre      @relation(fields: [genreId], references: [id], onDelete: Cascade)
  unit                Unit?      @relation(fields: [unitId], references: [id], onDelete: SetNull)
  tenant              Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  // 在庫(PartMaster)は (categoryId, partNumber) でサービス層から解決する（DB外部キーは張らない）

  @@index([tenantId])
  @@index([genreId])
  @@index([unitId])
  @@index([unitNumber])
  @@index([partNumber])
  @@index([storageCase])
  @@index([sortOrder])
  @@map("parts")
}

// ============================================================
// PartMaster: 在庫マスター（品番ごとの在庫数を一元管理）
// ============================================================
// 在庫は「カテゴリー×品番」で一意。categoryId=null は shared(全カテゴリー共有)用の従来レコード。
// perCategoryモードでは categoryId を持つレコードでカテゴリーごとに在庫を独立管理する。
// ※ Part とのリレーションは (categoryId, partNumber) で解決するためサービス層で扱う（DB外部キーは張らない）。
model PartMaster {
  id            String   @id @default(cuid())
  categoryId    String?  // null=shared（従来）/ 値あり=そのカテゴリー専用の在庫
  partNumber    String
  stockQuantity Int      @default(0)
  tenantId      String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, categoryId, partNumber])
  @@index([tenantId])
  @@index([partNumber])
  @@index([categoryId])
  @@map("part_masters")
}

// ============================================================
// DiagramImage: 展開図（ユニット単位で管理）
// ============================================================
model DiagramImage {
  id        String   @id @default(cuid())
  unitId    String   // genreIdからunitIdに変更
  imageUrl  String
  imageType String   @default("diagram")
  isMain    Boolean  @default(false) // メイン展開図フラグ（1ユニットにつき1枚）
  sortOrder Int      @default(0)     // サブ画像の並び順
  tenantId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  unit      Unit     @relation(fields: [unitId], references: [id], onDelete: Cascade)
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([unitId])
  @@index([sortOrder])
  @@map("diagram_images")
}

// ============================================================
// SystemSettings: システム設定（システム名・ロゴ・ヘッダー色）
// ============================================================
model SystemSettings {
  id               String   @id @default(cuid())
  systemName       String   @default("階層型在庫管理システム")
  logoUrl          String?  // ロゴ画像URL（任意）
  logoSize         String   @default("small") // ロゴサイズ: small / medium / large
  headerColor      String   @default("linear-gradient(135deg, #667eea 0%, #764ba2 100%)")
  stockMode        String   @default("shared") // 在庫モード: shared(全カテゴリー共有) / perCategory(カテゴリー独立)
  tenantId         String   // テナントごとに1レコード（@@unique([tenantId])）
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  tenant           Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId])
  @@map("system_settings")
}

// ============================================================
// StockCountLog: 棚卸し履歴（実数入力による在庫更新の記録）
// ============================================================
model StockCountLog {
  id         String   @id @default(cuid())
  partNumber String   // 品番
  partName   String   // 品名（当時の名称を保持）
  unitId     String?  // 棚卸ししたユニット
  unitName   String?  // ユニット名（当時）
  beforeQty  Int      // 変更前の在庫数
  afterQty   Int      // 実数（変更後の在庫数）
  diff       Int      // afterQty - beforeQty（過不足）
  countedBy  String?  // 実施した管理者（メール等）
  countedAt  DateTime @default(now())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([partNumber])
  @@index([unitId])
  @@index([countedAt])
  @@map("stock_count_logs")
}
